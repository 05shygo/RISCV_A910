-                               ) &&
-                              !(ifctrl_icache_if_tag_req
-                               ) &&
-                              !(pcgen_icache_if_chgflw &&
-                                 (pcgen_icache_if_way_pred[1:0] != 2'b00) && 
-                                cp0_ifu_icache_en
-                               ) &&
