-//    d.Vector SM Read
-//    e.Prefetch Read
-assign ifu_icache_tag_cen_b = !(l1_refill_icache_if_wr && 
-                                 (l1_refill_icache_if_first || 
-                                  l1_refill_icache_if_last) && 
