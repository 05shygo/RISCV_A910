+    .module_en         (cp0_ifu_icg_en),
+    .pad_yy_icg_scan_en(pad_yy_icg_scan_en)
+  );
+
+  assign bht_inv_cnt_clk_en = bht_inv_on_q || ifctrl_bht_inv;
+
+  always @(posedge bht_inv_cnt_clk or negedge cpurst_b) begin : p_bht_inval_cnt_pre
