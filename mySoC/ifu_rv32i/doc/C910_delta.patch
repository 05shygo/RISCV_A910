+
+  //-------------------Vghr pipe tp IP------------------------
+  always @(*) begin : p_vghr_value_comb
+    if (rtu_ifu_flush && cp0_ifu_bht_en) begin
+      vghr_value[21:0] = committed_recover_ghr[21:0];
