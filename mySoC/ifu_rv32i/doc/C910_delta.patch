+      bht_ipdp_vghr_q[21:0] <= 22'b0;
+    end else if (ifctrl_bht_pipedown && cp0_ifu_bht_en) begin
+      bht_ipdp_vghr_q[21:0] <= vghr_value[21:0];
+    end else begin
+      bht_ipdp_vghr_q[21:0] <= bht_ipdp_vghr_q[21:0];
+    end
