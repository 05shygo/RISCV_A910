+  genvar lane;
+  assign tag_hit  = {(&ifdp_ipdp_tag_match1), (&ifdp_ipdp_tag_match0)};
+  assign data_hit = tag_hit & ifdp_ipdp_way_pred;
+  assign data     = data_hit[0] ? ifdp_ipdp_inst_data0 : ifdp_ipdp_inst_data1;
+  generate
+    for (lane = 0; lane < 4; lane = lane + 1) begin : g_word
