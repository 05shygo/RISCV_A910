+        .inst             (inst),
+        .pc               (pc),
+        .condbr           (condbr),
+        .jal              (jal),
+        .jalr             (jalr),
+        .auipc            (auipc),
+        .pc_oper          (pc_oper),
+        .dst_vld          (dst),
+        .cf_type          (cf_type),
+        .ras_push         (push),
+        .ras_pop          (pop),
+        .ras_target_usable(usable),
+        .direct_target    (target),
+        .direct_misaligned(bad),
+        .link_pc          (link)
+      );
+      assign btb_hit = ifdp_ipdp_btb_hit[lane] && ifdp_ipdp_btb_target[lane*32+:2] == 2'b00;
