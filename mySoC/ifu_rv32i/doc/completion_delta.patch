+        ifdp_ipdp_bkpta[lane],
+        fence,
+        ifdp_ipdp_no_spec[lane],
+        (ifdp_ipdp_fault ? ifdp_ipdp_cause : 4'b0),
+        ifdp_ipdp_fault,
+        npc,
+        pc,
+        inst
