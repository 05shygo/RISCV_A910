+  wire [2:0] state_nxt;
+  wire state_en;
+  reg [31:0] pc_q;
+  wire [31:0] pc_nxt;
+  wire pc_en;
+  reg [4:0] attr_q;
+  wire [4:0] attr_nxt;
+  wire attr_en;
