+  assign killed_nxt=!start;
+  always @(posedge forever_cpuclk or negedge cpurst_b) begin : p_killed
+    if(!cpurst_b) killed_q<=1'b0;
+    else if(killed_en) killed_q<=killed_nxt;
+  end
+  assign replay_count_en=demand_grant || take_replay;
+  assign replay_count_nxt=demand_grant ? 2'b0 : replay_count_q+2'd1;
+  always @(posedge forever_cpuclk or negedge cpurst_b) begin : p_replay_count
+    if(!cpurst_b) replay_count_q<=2'b0;
+    else if(replay_count_en) replay_count_q<=replay_count_nxt;
+  end
+  assign replay_offset_en=demand_grant || take_replay;
+  assign replay_offset_nxt=demand_grant ? demand_pc[5:4] : replay_offset_q+2'd1;
+  always @(posedge forever_cpuclk or negedge cpurst_b) begin : p_replay_offset
+    if(!cpurst_b) replay_offset_q<=2'b0;
+    else if(replay_offset_en) replay_offset_q<=replay_offset_nxt;
+  end
+
+endmodule
