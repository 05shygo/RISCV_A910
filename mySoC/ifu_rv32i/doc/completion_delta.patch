+module rv32_ifu_ipdp (
+  input  wire [ 31:0] ifdp_ipdp_vpc,
+  input  wire [127:0] ifdp_ipdp_inst_data0,
+  input  wire [127:0] ifdp_ipdp_inst_data1,
+  input  wire [  2:0] ifdp_ipdp_tag_match0,
+  input  wire [  2:0] ifdp_ipdp_tag_match1,
+  input  wire [  1:0] ifdp_ipdp_way_pred,
+  input  wire         ifdp_ipdp_fault,
+  input  wire         ifdp_ipdp_lbuf_on,
+  input  wire [  3:0] ifdp_ipdp_cause,
+  input  wire [  3:0] ifdp_ipdp_bkpta,
+  input  wire [  3:0] ifdp_ipdp_bkptb,
+  input  wire [  3:0] ifdp_ipdp_no_spec,
+  input  wire [  3:0] remaining_mask,
+  input  wire         bht_pred,
+  input  wire [ 24:0] bht_chk_idx,
+  input  wire [  3:0] ifdp_ipdp_btb_hit,
+  input  wire [127:0] ifdp_ipdp_btb_target,
+  input  wire [  7:0] ifdp_ipdp_btb_way,
+  output wire [  1:0] tag_hit,
+  output wire [  1:0] data_hit,
+  output wire [  3:0] control_mask,
+  output wire [  3:0] cond_mask,
+  output wire [  3:0] taken_mask,
+  output wire [767:0] slot_packet,
+  output wire [127:0] slot_npc
