obj_dir
waveform
mycpu/*
meminit.bin
obj_nofsdb/

# 十六进制镜像 (2026-09-28): 由 bin/%.bin 派生, $readmemh 用。
# 上游产物 bin/*.bin 是**入库**的 (48 个用例镜像), 派生出来的 hex 不入库。
bin/*.hex
bin/*.hex128
meminit.hex
meminit128.hex

# Vivado 综合报告/工程 (fmax 时序收敛用, 由用户从另一台机器拷进来, 165 MB, 不入库)
fmax_impl_beh_*/

# synth/ 下的 Vivado 测量产物: 脚本、顶层 top_fmax.v 与 synth/reports/ 下的
# 报告/log 副本入库; 原始工程目录 (dcp/日志等 246MB) 不进
synth/vivado/
synth/*.log
synth/*.jou
synth/*.str
synth/.Xil/

# 根目录直接跑 Vivado 生成的会话文件 (2026-10-01)。根下 coremark_*.log 等是
# 故意入库的验证证据, 因此这里不用 *.log 通配, 只按文件名忽略 Vivado 会话文件。
vivado.jou
vivado.log

# tb/branch_predictor_championship 是**自带 .git 的嵌套仓库** (16 MB, C++ 选型模型)。
# 直接 git add 会变成 gitlink, 但没有 .gitmodules ⇒ 别人 clone 下来是个空目录。
# 要正式纳入请二选一: 加 .gitmodules 走 submodule, 或者删掉它的 .git 再整目录入库。
tb/branch_predictor_championship/

# VCS/Verdi 构建产物（2026-09-25: 此前误提交进仓库, 600 个文件已从索引移除;
# 下面的 obj_*/novas* 用通配符覆盖, 上面的单项是历史条目）
obj_*/
novas.fsdb
novas.fsdb.*
novas_dump.log
ucli.key
verdiLog/
simv
simv.daidir/
*.vpd
csrc/

# python
__pycache__/
*.pyc
