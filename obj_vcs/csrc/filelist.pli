PLI_STUB_OBJS_OBJ1=_vcs_pli_stub_.o
PLI_STUB_OBJS_SRC1=_vcs_pli_stub_.c
PLI_STUB_OBJS += $(PLI_STUB_OBJS_OBJ1)
$(PLI_STUB_OBJS_OBJ1): $(PLI_STUB_OBJS_SRC1)
	@$(CC) -I/mnt/tools/synopsys/vcs/V-2023.12-SP2/include  -pipe -fPIC -DVCS -I/x2025/GPrj1/IC1/riscv/RISCV_CPU/cdp-tests/golden_model/include    -I/mnt/tools/synopsys/vcs/V-2023.12-SP2/include  -fPIC -c -o $(PLI_STUB_OBJS_OBJ1) $(PLI_STUB_OBJS_SRC1)
	@strip -g $(PLI_STUB_OBJS_OBJ1)
