DPI_STUB_OBJS_OBJ0=./../simv.daidir/vc_hdrs.o
DPI_STUB_OBJS_SRC0=./../simv.daidir/vc_hdrs.c
DPI_STUB_OBJS += $(DPI_STUB_OBJS_OBJ0)
$(DPI_STUB_OBJS_OBJ0): $(DPI_STUB_OBJS_SRC0)
	@$(CC) -I/mnt/tools/synopsys/vcs/V-2023.12-SP2/include  -pipe -fPIC -DVCS -I/x2025/GPrj1/IC1/riscv/RISCV_CPU/cdp-tests/golden_model/include    -I/mnt/tools/synopsys/vcs/V-2023.12-SP2/include  -fPIC -c -o $(DPI_STUB_OBJS_OBJ0) $(DPI_STUB_OBJS_SRC0)
	@strip -g $(DPI_STUB_OBJS_OBJ0)
